# Claude APIキー（必須）
ANTHROPIC_API_KEY=

# 日本語フォントのパス（Windows推奨: .ttf/.otf単体フォント。.ttcはデフォルト面選択が不安定なため非推奨）
# 例: PODCAST_CLIPPER_FONT_PATH=C:/Windows/Fonts/YuGothM.ttc
# 単体フォントを別途用意する場合の例: PODCAST_CLIPPER_FONT_PATH=C:/Fonts/NotoSansJP-Bold.otf
PODCAST_CLIPPER_FONT_PATH=C:/Windows/Fonts/meiryo.ttc

# 動画中に常時表示するウォーターマーク（絶対条件8。既定値のまま推奨）
PODCAST_CLIPPER_WATERMARK_TEXT=VF高西で検索！

# OP/イントロ除外秒数（任意。未設定なら固定秒数による除外は一切行わない。設定した場合のみ、
# その秒数より前のセグメントは候補の対象から除外される）
# PODCAST_CLIPPER_OP_EXCLUSION_SECONDS=20

# 出力先ディレクトリ（任意、既定は ./output）
# PODCAST_CLIPPER_OUTPUT_DIR=./output

# Whisperモデル設定（任意）
# PODCAST_CLIPPER_WHISPER_MODEL=large-v3
# PODCAST_CLIPPER_WHISPER_DEVICE=cpu
# PODCAST_CLIPPER_WHISPER_COMPUTE_TYPE=int8

# Claudeモデル（任意）
# PODCAST_CLIPPER_ANTHROPIC_MODEL=claude-sonnet-5

# クラウド公開時のパスワード保護（任意。ローカル利用では通常不要。
# 詳細は CLOUD_DEPLOY.md 参照。未設定ならパスワード認証なしで動作する）
# TOOL_PASSWORD=
